# Hermes test instance for Pylon.
#
# Runs a throwaway Hermes under its own user, with no path to the real
# /var/lib/hermes and no outbound network. Everything the app needs from it is
# local: the gateway, the fixture data, and the stub model provider.
#
# Install (root):
#   useradd --system --home /var/lib/pylon-test --shell /run/current-system/sw/bin/nologin pylon-test
#   install -d -o pylon-test -g pylon-test /var/lib/pylon-test/data /var/lib/pylon-test/chrome
#   cp pylon-test.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now pylon-test

[Unit]
Description=Hermes test instance for Pylon (throwaway, loopback only)
After=network.target

[Service]
Type=simple
User=pylon-test
Group=pylon-test
Environment=HOME=/var/lib/pylon-test
Environment=HERMES_HOME=/var/lib/pylon-test/data
Environment=PYLON_STUB_PORT=19200
Environment=PATH=/run/current-system/sw/bin:/usr/bin:/bin
WorkingDirectory=/var/lib/pylon-test

# The stub provider and the gateway, in that order: sessions and logs are seeded by
# running one conversation against the stub, so it has to exist first.
ExecStartPre=/run/current-system/sw/bin/python3 /var/lib/pylon-test/stub_provider.py --port 19200
ExecStart=/run/current-system/sw/bin/hermes gateway start --host 127.0.0.1 --port 19119
Restart=on-failure
RestartSec=2

# Isolation. Load-bearing: the fixture password is only safe because none of
# this can reach real data or a real network.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
ReadWritePaths=/var/lib/pylon-test

# No egress. Loopback stays reachable so the gateway can talk to the stub and
# the harness can talk to both.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
